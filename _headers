# Cloudflare Pages / Netlify Headers configuration for Cache Control

# HTML pages - revalidate on every request so structural updates & meta updates reflect immediately
/*.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

/
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# JSON data files - no-cache so catalogue & product data edits load instantly
/data/*.json
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache

# Static JS and CSS assets - aggressive caching for minified production bundles
/js/min/*.js
  Cache-Control: public, max-age=31536000, immutable

/css/*.min.css
  Cache-Control: public, max-age=31536000, immutable

/styles.min.css
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
